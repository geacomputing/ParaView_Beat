        <Proxy value="10836" output_port="0"/>
        <Domain name="groups" id="11202.Input.groups"/>
        <Domain name="input_type" id="11202.Input.input_type"/>
      </Property>
      <Property name="OutputDataSetType" id="11202.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="4"/>
        <Domain name="enum" id="11202.OutputDataSetType.enum">
          <Entry value="8" text="Same as Input"/>
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="10" text="vtkUniformGrid"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="32" text="vtkHyperTreeGrid"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PythonPath" id="11202.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="11202.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;from vtk.util.numpy_support import numpy_to_vtk, vtk_to_numpy&#xa;&#xa;STEP = 30&#xa;X_SLICE = slice(None)  # Example: slice(500, 1500)&#xa;Y_SLICE = slice(None)&#xa;Z_SCALE = 1 / 10000  # Approx. metres to degrees for lon/lat display&#xa;&#xa;src = self.GetInputDataObject(0, 0)&#xa;out = self.GetOutputDataObject(0)&#xa;&#xa;nx, ny, nz = src.GetDimensions()&#xa;elevation = src.GetPointData().GetArray(&#x22;elevation&#x22;)&#xa;if nz != 1 or nx &#x3c; 2 or ny &#x3c; 2 or elevation is None:&#xa;    raise ValueError(&#x22;Expected a 2D GEBCO grid with point-data &#x27;elevation&#x27;.&#x22;)&#xa;&#xa;ix = np.arange(nx)[X_SLICE][::STEP]&#xa;iy = np.arange(ny)[Y_SLICE][::STEP]&#xa;&#xa;origin = np.array(src.GetPoint(0))&#xa;dx = abs(src.GetPoint(1)[0] - origin[0]) * STEP&#xa;dy = abs(src.GetPoint(nx)[1] - origin[1]) * STEP&#xa;&#xa;x = [src.GetPoint(int(i))[0] for i in ix]&#xa;y = [src.GetPoint(int(j * nx))[1] for j in iy]&#xa;xx, yy = np.meshgrid(x, y)&#xa;z = vtk_to_numpy(elevation).reshape(ny, nx)[np.ix_(iy, ix)]&#xa;&#xa;valid = np.isfinite(z)&#xa;x, y, z = xx[valid], yy[valid], z[valid]&#xa;height = z * Z_SCALE&#xa;&#xa;# Counterclockwise rectangle, repeated on the bottom and top faces.&#xa;corners = np.array([[-1, -1], [1, -1], [1, 1], [-1, 1]])&#xa;xyz = np.empty((len(z), 8, 3))&#xa;xyz[:, :, 0] = x[:, None] + np.tile(corners[:, 0], 2) * dx / 2&#xa;xyz[:, :, 1] = y[:, None] + np.tile(corners[:, 1], 2) * dy / 2&#xa;xyz[:, :4, 2] = np.minimum(height, 0)[:, None]&#xa;xyz[:, 4:, 2] = np.maximum(height, 0)[:, None]&#xa;&#xa;out.Initialize()&#xa;points = vtk.vtkPoints()&#xa;points.SetData(numpy_to_vtk(xyz.reshape(-1, 3), deep=True))&#xa;out.SetPoints(points)&#xa;out.Allocate(len(z))&#xa;&#xa;ids = vtk.vtkIdList()&#xa;ids.SetNumberOfIds(8)&#xa;for cell in range(len(z)):&#xa;    for corner in range(8):&#xa;        ids.SetId(corner, 8 * cell + corner)&#xa;    cell_type = vtk.VTK_HEXAHEDRON if z[cell] != 0 else vtk.VTK_QUAD&#xa;    if cell_type == vtk.VTK_QUAD:&#xa;        ids.SetNumberOfIds(4)&#xa;    out.InsertNextCell(cell_type, ids)&#xa;    ids.SetNumberOfIds(8)&#xa;&#xa;values = numpy_to_vtk(z, deep=True)&#xa;values.SetName(&#x22;elevation&#x22;)&#xa;out.GetCellData().SetScalars(values)"/>
      </Property>
      <Property name="TimestepValues" id="11202.TimestepValues"/>
      <Property name="UpdateExtentScript" id="11202.UpdateExtentScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
    </Proxy>
