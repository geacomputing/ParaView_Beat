    <Proxy group="sources" type="ProgrammableSource" id="14900" servers="1">
      <Property name="InformationScript" id="14900.InformationScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="OutputDataSetType" id="14900.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="enum" id="14900.OutputDataSetType.enum">
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PythonPath" id="14900.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="14900.Script" number_of_elements="1">
        <Element index="0" value="import vtk&#xa;&#xa;GRID_SIZE = 200       # Estensione: -100 a +100&#xa;GRID_SPACING = 4.0    # Distanza tra le linee&#xa;Z = -0.05             # Sotto l&#x27;equalizzatore&#xa;&#xa;points = vtk.vtkPoints()&#xa;lines = vtk.vtkCellArray()&#xa;&#xa;def add_line(p1, p2):&#xa;    a = points.InsertNextPoint(*p1)&#xa;    b = points.InsertNextPoint(*p2)&#xa;&#xa;    line = vtk.vtkLine()&#xa;    line.GetPointIds().SetId(0, a)&#xa;    line.GetPointIds().SetId(1, b)&#xa;    lines.InsertNextCell(line)&#xa;&#xa;n = int(GRID_SIZE / GRID_SPACING)&#xa;&#xa;for i in range(-n, n + 1):&#xa;    v = i * GRID_SPACING&#xa;&#xa;    # Linee parallele all&#x27;asse X&#xa;    add_line(&#xa;        (-GRID_SIZE, v, Z),&#xa;        ( GRID_SIZE, v, Z)&#xa;    )&#xa;&#xa;    # Linee parallele all&#x27;asse Y&#xa;    add_line(&#xa;        (v, -GRID_SIZE, Z),&#xa;        (v,  GRID_SIZE, Z)&#xa;    )&#xa;&#xa;output.SetPoints(points)&#xa;output.SetLines(lines)"/>
      </Property>
      <Property name="TimestepValues" id="14900.TimestepValues"/>
    </Proxy>
    <Proxy group="sources" type="VectorText" id="14664" servers="1">
      <Property name="Text" id="14664.Text" number_of_elements="1">
        <Element index="0" value="Joy Division"/>
      </Property>
    </Proxy>
    <Proxy group="sources" type="LiveProgrammableSource" id="15394" servers="1">
      <Property name="CheckNeedsUpdateScript" id="15394.CheckNeedsUpdateScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="InformationScript" id="15394.InformationScript" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;&#xa;NPZ_PATH = (&#xa;    &#x22;/home/user/Documents/Gea/Sci.Viz/&#x22;&#xa;    &#x22;ParaView_Beat/audio/joy/&#x22;&#xa;    &#x22;spectrum_output/spectrum.npz&#x22;&#xa;)&#xa;&#xa;with np.load(NPZ_PATH) as data:&#xa;    times = np.asarray(&#xa;        data[&#x22;time&#x22;],&#xa;        dtype=np.float64&#xa;    )&#xa;&#xa;executive = self.GetExecutive()&#xa;out_info = executive.GetOutputInformation(0)&#xa;&#xa;time_steps_key = (&#xa;    vtk.vtkStreamingDemandDrivenPipeline.TIME_STEPS()&#xa;)&#xa;&#xa;time_range_key = (&#xa;    vtk.vtkStreamingDemandDrivenPipeline.TIME_RANGE()&#xa;)&#xa;&#xa;out_info.Remove(time_steps_key)&#xa;out_info.Remove(time_range_key)&#xa;&#xa;out_info.Set(&#xa;    time_steps_key,&#xa;    times,&#xa;    len(times)&#xa;)&#xa;&#xa;out_info.Set(&#xa;    time_range_key,&#xa;    [float(times[0]), float(times[-1])],&#xa;    2&#xa;)"/>
      </Property>
      <Property name="OutputDataSetType" id="15394.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="enum" id="15394.OutputDataSetType.enum">
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PauseLiveSource" id="15394.PauseLiveSource"/>
      <Property name="PythonPath" id="15394.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="15394.Script" number_of_elements="1">
        <Element index="0" value="#script: &#xa;&#xa;&#xa;import builtins&#xa;import numpy as np&#xa;import vtk&#xa;&#xa;# ============================================================&#xa;# CONFIGURATION&#xa;# ============================================================&#xa;&#xa;NPZ_PATH = (&#xa;    &#x22;/home/user/Documents/Gea/Sci.Viz/&#x22;&#xa;    &#x22;ParaView_Beat/audio/joy/&#x22;&#xa;    &#x22;spectrum_output/spectrum.npz&#x22;&#xa;)&#xa;&#xa;DEFAULT_BANDS = 32&#xa;&#xa;BAR_WIDTH = 0.8&#xa;BAR_DEPTH = 0.8&#xa;BAR_GAP = 0.2&#xa;&#xa;MAX_HEIGHT = 10.0&#xa;MIN_HEIGHT = 0.02&#xa;&#xa;PEAK_THICKNESS = 0.12&#xa;PEAK_GAP = 0.08&#xa;&#xa;# ============================================================&#xa;# LOAD AUDIO DATA&#xa;# ============================================================&#xa;&#xa;with np.load(NPZ_PATH) as data:&#xa;    times = data[&#x22;time&#x22;]&#xa;    amplitudes = data[&#x22;amplitude&#x22;]&#xa;    peaks = data[&#x22;peaks&#x22;]&#xa;&#xa;n_bands = builtins.min(&#xa;    DEFAULT_BANDS,&#xa;    amplitudes.shape[1]&#xa;)&#xa;&#xa;# ============================================================&#xa;# GET ANIMATION TIME&#xa;# ============================================================&#xa;&#xa;executive = self.GetExecutive()&#xa;out_info = executive.GetOutputInformation(0)&#xa;&#xa;time_key = vtk.vtkStreamingDemandDrivenPipeline.UPDATE_TIME_STEP()&#xa;&#xa;if out_info.Has(time_key):&#xa;    t = float(out_info.Get(time_key))&#xa;else:&#xa;    t = 0.0&#xa;&#xa;t = float(np.clip(t, times[0], times[-1]))&#xa;&#xa;# ============================================================&#xa;# INTERPOLATE AUDIO&#xa;# ============================================================&#xa;&#xa;values = np.array([&#xa;    np.interp(t, times, amplitudes[:, i])&#xa;    for i in range(n_bands)&#xa;])&#xa;&#xa;peak_values = np.array([&#xa;    np.interp(t, times, peaks[:, i])&#xa;    for i in range(n_bands)&#xa;])&#xa;&#xa;# ============================================================&#xa;# CREATE GEOMETRY&#xa;# ============================================================&#xa;&#xa;points = vtk.vtkPoints()&#xa;polys = vtk.vtkCellArray()&#xa;&#xa;band_ids = vtk.vtkIntArray()&#xa;band_ids.SetName(&#x22;Band&#x22;)&#xa;&#xa;element_types = vtk.vtkIntArray()&#xa;element_types.SetName(&#x22;ElementType&#x22;)&#xa;&#xa;levels = vtk.vtkFloatArray()&#xa;levels.SetName(&#x22;Amplitude&#x22;)&#xa;&#xa;frequency_hz = vtk.vtkFloatArray()&#xa;frequency_hz.SetName(&#x22;FrequencyHz&#x22;)&#xa;&#xa;# Frequency centers, if available&#xa;with np.load(NPZ_PATH) as data:&#xa;    if &#x22;frequency_centers&#x22; in data:&#xa;        centers = data[&#x22;frequency_centers&#x22;]&#xa;    else:&#xa;        edges = data[&#x22;frequency_edges&#x22;]&#xa;        centers = np.sqrt(edges[:-1] * edges[1:])&#xa;&#xa;&#xa;# ============================================================&#xa;# BOX GENERATOR&#xa;# ============================================================&#xa;&#xa;def add_box(&#xa;    x0, x1,&#xa;    y0, y1,&#xa;    z0, z1,&#xa;    band_id,&#xa;    element_type,&#xa;    level,&#xa;    frequency&#xa;):&#xa;&#xa;    base = points.GetNumberOfPoints()&#xa;&#xa;    vertices = [&#xa;        (x0, y0, z0),&#xa;        (x1, y0, z0),&#xa;        (x1, y1, z0),&#xa;        (x0, y1, z0),&#xa;&#xa;        (x0, y0, z1),&#xa;        (x1, y0, z1),&#xa;        (x1, y1, z1),&#xa;        (x0, y1, z1),&#xa;    ]&#xa;&#xa;    for vertex in vertices:&#xa;        points.InsertNextPoint(*vertex)&#xa;&#xa;    faces = [&#xa;        (0, 3, 2, 1),&#xa;        (4, 5, 6, 7),&#xa;        (0, 1, 5, 4),&#xa;        (1, 2, 6, 5),&#xa;        (2, 3, 7, 6),&#xa;        (3, 0, 4, 7),&#xa;    ]&#xa;&#xa;    for face in faces:&#xa;&#xa;        quad = vtk.vtkQuad()&#xa;&#xa;        for j, vertex_id in enumerate(face):&#xa;            quad.GetPointIds().SetId(&#xa;                j,&#xa;                base + vertex_id&#xa;            )&#xa;&#xa;        polys.InsertNextCell(quad)&#xa;&#xa;        band_ids.InsertNextValue(&#xa;            int(band_id)&#xa;        )&#xa;&#xa;        element_types.InsertNextValue(&#xa;            int(element_type)&#xa;        )&#xa;&#xa;        levels.InsertNextValue(&#xa;            float(level)&#xa;        )&#xa;&#xa;        frequency_hz.InsertNextValue(&#xa;            float(frequency)&#xa;        )&#xa;&#xa;&#xa;# ============================================================&#xa;# BUILD EQUALIZER&#xa;# ============================================================&#xa;&#xa;pitch = BAR_WIDTH + BAR_GAP&#xa;&#xa;total_width = (&#xa;    n_bands * pitch - BAR_GAP&#xa;)&#xa;&#xa;for i in range(n_bands):&#xa;&#xa;    # Horizontal positioning&#xa;    x0 = i * pitch - total_width / 2.0&#xa;    x1 = x0 + BAR_WIDTH&#xa;&#xa;    y0 = -BAR_DEPTH / 2.0&#xa;    y1 = BAR_DEPTH / 2.0&#xa;&#xa;    amplitude = float(values[i])&#xa;    peak = float(peak_values[i])&#xa;&#xa;    frequency = float(centers[i])&#xa;&#xa;    # --------------------------------------------------------&#xa;    # MAIN BAR&#xa;    # --------------------------------------------------------&#xa;&#xa;    height = builtins.max(&#xa;        MIN_HEIGHT,&#xa;        amplitude * MAX_HEIGHT&#xa;    )&#xa;&#xa;    add_box(&#xa;        x0, x1,&#xa;        y0, y1,&#xa;        0.0, height,&#xa;        i,&#xa;        0,&#xa;        amplitude,&#xa;        frequency&#xa;    )&#xa;&#xa;    # --------------------------------------------------------&#xa;    # PEAK HOLD INDICATOR&#xa;    # --------------------------------------------------------&#xa;&#xa;    peak_height = peak * MAX_HEIGHT&#xa;&#xa;    peak_bottom = peak_height + PEAK_GAP&#xa;    peak_top = peak_bottom + PEAK_THICKNESS&#xa;&#xa;    add_box(&#xa;        x0, x1,&#xa;        y0, y1,&#xa;        peak_bottom, peak_top,&#xa;        i,&#xa;        1,&#xa;        peak,&#xa;        frequency&#xa;    )&#xa;&#xa;&#xa;# ============================================================&#xa;# OUTPUT&#xa;# ============================================================&#xa;&#xa;output.SetPoints(points)&#xa;output.SetPolys(polys)&#xa;&#xa;output.GetCellData().AddArray(band_ids)&#xa;output.GetCellData().AddArray(element_types)&#xa;output.GetCellData().AddArray(levels)&#xa;output.GetCellData().AddArray(frequency_hz)&#xa;&#xa;output.Modified()&#xa;&#xa;"/>
      </Property>
