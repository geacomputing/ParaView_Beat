    <Proxy group="sources" type="ProgrammableSource" id="13953" servers="1">
      <Property name="InformationScript" id="13953.InformationScript" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;&#xa;NPZ = &#x22;/home/user/Documents/Gea/Sci.Viz/ParaView_Beat/audio/joy/spectrum_output/spectrum.npz&#x22;&#xa;STRIDE = 4&#xa;HISTORY = 64&#xa;&#xa;with np.load(NPZ, allow_pickle=False) as data:&#xa;    times = data[&#x22;time&#x22;][::STRIDE].copy()&#xa;    amplitudes = data[&#x22;amplitude&#x22;][::STRIDE].copy()&#xa;&#xa;if times.ndim != 1 or times.size == 0:&#xa;    raise ValueError(&#x22;Expected a nonempty 1D time array.&#x22;)&#xa;if amplitudes.ndim != 2 or amplitudes.shape[0] != times.size:&#xa;    raise ValueError(&#x22;Expected one spectrum per timestep.&#x22;)&#xa;if amplitudes.shape[1] &#x3c; 2:&#xa;    raise ValueError(&#x22;Expected at least two frequency bands.&#x22;)&#xa;&#xa;self.spectrum_data = times, amplitudes, HISTORY&#xa;&#xa;executive = self.GetExecutive()&#xa;info = executive.GetOutputInformation(0)&#xa;&#xa;info.Remove(executive.TIME_STEPS())&#xa;for time in times:&#xa;    info.Append(executive.TIME_STEPS(), float(time))&#xa;&#xa;info.Remove(executive.TIME_RANGE())&#xa;info.Append(executive.TIME_RANGE(), float(times[0]))&#xa;info.Append(executive.TIME_RANGE(), float(times[-1]))"/>
      </Property>
      <Property name="OutputDataSetType" id="13953.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="enum" id="13953.OutputDataSetType.enum">
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PythonPath" id="13953.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="13953.Script" number_of_elements="1">
        <Element index="0" value="import builtins&#xa;&#xa;import numpy as np&#xa;import vtk&#xa;from vtk.util.numpy_support import numpy_to_vtk&#xa;&#xa;ROW_SPACING = 0.5&#xa;HEIGHT = 6.0&#xa;FADE_POWER = 4.0&#xa;&#xa;times, amplitudes, history = self.spectrum_data&#xa;&#xa;executive = self.GetExecutive()&#xa;info = executive.GetOutputInformation(0)&#xa;key = executive.UPDATE_TIME_STEP()&#xa;t = info.Get(key) if info.Has(key) else times[0]&#xa;&#xa;frame = builtins.min(int(np.searchsorted(times, t)), times.size - 1)&#xa;if frame &#x3e; 0 and abs(t - times[frame - 1]) &#x3c; abs(t - times[frame]):&#xa;    frame -= 1&#xa;&#xa;start = builtins.max(0, frame - history + 1)&#xa;rows = amplitudes[start:frame + 1][::-1]&#xa;&#xa;points = vtk.vtkPoints()&#xa;lines = vtk.vtkCellArray()&#xa;&#xa;for age, row in enumerate(rows):&#xa;    y = age * ROW_SPACING&#xa;    ids = [&#xa;        points.InsertNextPoint(band, y, HEIGHT * float(amplitude))&#xa;        for band, amplitude in enumerate(row)&#xa;    ]&#xa;    lines.InsertNextCell(len(ids), ids)&#xa;&#xa;# Smooth transition with a gentle start and end.&#xa;age = np.arange(len(rows), dtype=float) / builtins.max(1, history - 1)&#xa;brightness = ((1.0 - age) ** 2 * (1.0 + 2.0 * age)) ** FADE_POWER&#xa;gray = np.rint(255 * brightness).astype(np.uint8)&#xa;&#xa;# Give every point on a line the same RGB value.&#xa;point_gray = np.repeat(gray, rows.shape[1])&#xa;rgb = np.repeat(point_gray[:, None], 3, axis=1)&#xa;colors = numpy_to_vtk(rgb, deep=True)&#xa;colors.SetName(&#x22;Ridge RGB&#x22;)&#xa;&#xa;out = self.GetOutputDataObject(0)&#xa;out.Initialize()&#xa;out.SetPoints(points)&#xa;out.SetLines(lines)&#xa;out.GetPointData().SetScalars(colors)&#xa;out.GetInformation().Set(out.DATA_TIME_STEP(), float(times[frame]))"/>
      </Property>
